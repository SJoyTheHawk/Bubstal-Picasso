IMAGE_GEN_BACKEND=qwen
QWEN_SERVICE_URL=http://127.0.0.1:8001
QWEN_TIMEOUT_MS=300000
QWEN_MODEL_ID=Qwen/Qwen-Image-Edit-2509
# Sequential offload is the safest default for 24 GB GPUs. Use `model` on
# larger GPUs, or `none` only when the full pipeline fits in VRAM.
# QWEN_OFFLOAD_MODE=sequential

# Gemini remains the Shaper backend. Configure ADC separately.
GEMINI_PROJECT_ID=
GEMINI_LOCATION=global
SHAPER_MODEL_ID=gemini-3.5-flash
GEMINI_MODEL_ID=gemini-3-pro-image
PORT=3000
